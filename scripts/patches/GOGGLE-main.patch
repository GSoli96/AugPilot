 # 3rd Party
-from dgl.nn import GraphConv, SAGEConv
+import torch
 from torch import nn
 
+try:
+    from dgl.nn import GraphConv, SAGEConv
+except ImportError:
+    class GraphConv(nn.Module):
+        def __init__(self, in_feats, out_feats, norm="both", weight=True, bias=True, activation=None):
+            super().__init__()
+            self.linear = nn.Linear(in_feats, out_feats, bias=bias) if weight else None
+            self.activation = activation
+            self.norm = norm
+
+        def forward(self, graph, feat, edge_weight=None):
+            b_size = getattr(graph, 'b_size', 1)
+            n_nodes = getattr(graph, 'n_nodes', feat.shape[0] // b_size)
+            h = self.linear(feat) if self.linear is not None else feat
+            out_dim = h.shape[-1]
+            h_b = h.view(b_size, n_nodes, out_dim)
+
+            if hasattr(graph, 'edge_index') and edge_weight is not None and graph.edge_index.numel() > 0:
+                edge_index = graph.edge_index
+                row, col = edge_index[0], edge_index[1]
+                adj = torch.zeros((n_nodes, n_nodes), device=feat.device, dtype=feat.dtype)
+                n_edges = len(row)
+                adj[row, col] = edge_weight[:n_edges]
+                deg = torch.sum(adj, dim=1) + 1e-6
+                deg_inv_sqrt = torch.pow(deg, -0.5)
+                deg_inv_sqrt[torch.isinf(deg_inv_sqrt)] = 0.
+                norm_adj = deg_inv_sqrt.unsqueeze(1) * adj * deg_inv_sqrt.unsqueeze(0)
+                out = torch.bmm(norm_adj.unsqueeze(0).expand(b_size, -1, -1), h_b)
+            else:
+                out = h_b
+
+            out = out.reshape(b_size * n_nodes, out_dim)
+            if self.activation is not None:
+                out = self.activation(out)
+            return out
+
+    class SAGEConv(nn.Module):
+        def __init__(self, in_feats, out_feats, aggregator_type="mean", bias=True, activation=None):
+            super().__init__()
+            self.linear = nn.Linear(in_feats, out_feats, bias=bias)
+            self.activation = activation
+
+        def forward(self, graph, feat, edge_weight=None):
+            b_size = getattr(graph, 'b_size', 1)
+            n_nodes = getattr(graph, 'n_nodes', feat.shape[0] // b_size)
+            h_b = feat.view(b_size, n_nodes, -1)
+            if hasattr(graph, 'edge_index') and edge_weight is not None and graph.edge_index.numel() > 0:
+                row, col = graph.edge_index[0], graph.edge_index[1]
+                adj = torch.zeros((n_nodes, n_nodes), device=feat.device, dtype=feat.dtype)
+                n_edges = len(row)
+                adj[row, col] = edge_weight[:n_edges]
+                deg = torch.sum(adj, dim=1, keepdim=True) + 1e-6
+                norm_adj = adj / deg
+                agg = torch.bmm(norm_adj.unsqueeze(0).expand(b_size, -1, -1), h_b)
+                out = self.linear(agg)
+            else:
+                out = self.linear(h_b)
+            out = out.reshape(b_size * n_nodes, -1)
+            if self.activation is not None:
+                out = self.activation(out)
+            return out
+
